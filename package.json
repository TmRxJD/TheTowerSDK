{
  "name": "thetowersdk",
  "version": "0.5.4",
  "description": "Game data and save-file reading for The Tower \u2014 build your own calculators and tools.",
  "license": "MIT",
  "author": "TmRxJD (https://github.com/TmRxJD)",
  "homepage": "https://tmrxjd.github.io/TheTowerSDK/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TmRxJD/TheTowerSDK.git"
  },
  "bugs": {
    "url": "https://github.com/TmRxJD/TheTowerSDK/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "thetowersdk-mcp": "./mcp/server.mjs"
  },
  "sideEffects": false,
  "keywords": [
    "the-tower",
    "thetower",
    "tower-defense",
    "game-data",
    "save-file",
    "calculator",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && npm run knowledge:emit",
    "knowledge:emit": "node scripts/emit-knowledge-graph.mjs",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.build.json --noEmit",
    "type-check:examples": "tsc -p tsconfig.examples.json",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:docs": "node scripts/check-readme-links.mjs",
    "wiki:build": "node scripts/build-wiki.mjs",
    "wiki:publish": "node scripts/publish-wiki.mjs",
    "wiki:check": "node scripts/build-wiki.mjs --check",
    "lint:published": "node scripts/audit-published-surface.mjs",
    "examples:run": "node scripts/run-examples.mjs",
    "lint:conventions": "node scripts/check-conventions.mjs",
    "lint:acronyms": "tsx scripts/check-acronym-expansions.ts",
    "test:schema": "vitest run src/data/schemas.test.ts",
    "verify": "npm run lint && npm run lint:conventions && npm run lint:acronyms && npm run lint:docs && npm run wiki:check && npm run lint:published && npm run type-check && npm run type-check:examples && npm run build && npm test && npm run docs:check",
    "mcp": "node mcp/server.mjs",
    "glossary": "npm run build && node scripts/generate-glossary.mjs",
    "bot:demo": "tsx templates/bot-starter.ts",
    "bot:test": "vitest run src/bot",
    "sheets:test": "vitest run src/sheets",
    "docs:snippets": "node scripts/build-doc-snippets.mjs",
    "docs:seed": "npm run docs:snippets && npm run wiki:build",
    "docs:check": "node scripts/build-doc-snippets.mjs --check && npm run wiki:check && node scripts/check-readme-links.mjs && node scripts/build-asset-manifest.mjs --check",
    "assets:manifest": "node scripts/build-asset-manifest.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "require": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./save": {
      "types": "./dist/save/index.d.ts",
      "require": "./dist/save/index.js",
      "default": "./dist/save/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "require": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./formatting": {
      "types": "./dist/formatting/index.d.ts",
      "require": "./dist/formatting/index.js",
      "default": "./dist/formatting/index.js"
    },
    "./inputs": {
      "types": "./dist/inputs/index.d.ts",
      "require": "./dist/inputs/index.js",
      "default": "./dist/inputs/index.js"
    },
    "./builders": {
      "types": "./dist/builders/index.d.ts",
      "import": "./dist/builders/index.js",
      "require": "./dist/builders/index.js",
      "default": "./dist/builders/index.js"
    },
    "./mechanics": {
      "types": "./dist/mechanics/index.d.ts",
      "require": "./dist/mechanics/index.js",
      "default": "./dist/mechanics/index.js"
    },
    "./wiki": {
      "types": "./dist/wiki/index.d.ts",
      "require": "./dist/wiki/index.js",
      "default": "./dist/wiki/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "require": "./dist/charts/index.js",
      "default": "./dist/charts/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "require": "./dist/knowledge/index.js",
      "default": "./dist/knowledge/index.js"
    },
    "./internal/*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./knowledge-graph.json": "./dist/knowledge/knowledge-graph.v1.json",
    "./knowledge.schema.json": "./dist/knowledge/knowledge.schema.json",
    "./package.json": "./package.json",
    "./sheets": {
      "types": "./dist/sheets/index.d.ts",
      "import": "./dist/sheets/index.js",
      "require": "./dist/sheets/index.js",
      "default": "./dist/sheets/index.js"
    },
    "./bot": {
      "types": "./dist/bot/index.d.ts",
      "import": "./dist/bot/index.js",
      "require": "./dist/bot/index.js",
      "default": "./dist/bot/index.js"
    },
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "import": "./dist/assets/index.js",
      "require": "./dist/assets/index.js",
      "default": "./dist/assets/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "inputs": [
        "dist/inputs/index.d.ts"
      ],
      "builders": [
        "dist/builders/index.d.ts"
      ],
      "data": [
        "dist/data/index.d.ts"
      ],
      "charts": [
        "dist/charts/index.d.ts"
      ],
      "knowledge": [
        "dist/knowledge/index.d.ts"
      ],
      "save": [
        "dist/save/index.d.ts"
      ],
      "node": [
        "dist/node/index.d.ts"
      ],
      "formatting": [
        "dist/formatting/index.d.ts"
      ],
      "mechanics": [
        "dist/mechanics/index.d.ts"
      ],
      "wiki": [
        "dist/wiki/index.d.ts"
      ],
      "internal/*": [
        "dist/*.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "sheets": [
        "dist/sheets/index.d.ts"
      ],
      "bot": [
        "dist/bot/index.d.ts"
      ],
      "assets": [
        "dist/assets/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "mcp",
    "README.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "LICENSE",
    "NOTICE",
    "!dist/mechanics/doctor/**",
    "!dist/mechanics/kernel/**",
    "!dist/mechanics/registry/**",
    "!dist/mechanics/sandbox/**",
    "!dist/mechanics/calculators/specs-generated.*"
  ],
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
