# Copy to `.env` and fill in. Never commit the filled-in copy or the key file it points at.
#
# A service-account key is a password to every sheet that account can see. If one leaks,
# revoke it in the Google Cloud console (IAM → Service Accounts → Keys) — rotating the file
# is not enough on its own, the old key stays valid until you delete it.

# --- Google Sheets ------------------------------------------------------------
#
# Absolute path to the service-account JSON key you downloaded.
# See docs/GOOGLE_SHEETS.md for creating the account and sharing a sheet with it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# The id from your spreadsheet's URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
#
# Point this at YOUR OWN COPY. Do not write to a published community workbook — list any
# such id in PROTECTED_SPREADSHEETS in templates/sheets-client.ts instead.
SHEET_ID=

# --- Discord ------------------------------------------------------------------
#
# Bot token from the Discord developer portal (Applications → Bot → Reset Token).
# This is a password. Anyone holding it controls the bot.
DISCORD_TOKEN=

# Application id, from the same page. Not secret.
DISCORD_APPLICATION_ID=

# Optional: register slash commands to one guild while developing. Guild commands appear
# immediately; global ones can take up to an hour to propagate.
DISCORD_DEV_GUILD_ID=
