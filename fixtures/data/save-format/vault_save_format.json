{
  "description": "Documents how Vault data is stored in the savedFile format. The Vault has two tabs: Harmony (quality-of-life perks) and Power (stat boosts with tier multipliers).",
  "vaultHeaders": {
    "harmonyNodesUnlocked": "harmonyNodesUnlocked",
    "powerNodesUnlocked": "powerNodesUnlocked",
    "powerNodesLevel": "powerNodesLevel"
  },
  "fields": {
    "harmonyNodesUnlocked": {
      "description": "Boolean list — one entry per Harmony node in harmonyNodeOrder. True if that node is unlocked. Unlocked nodes are stored by name with value true in the import map.",
      "indexing": "node index i → harmonyNodesUnlocked[i]"
    },
    "powerNodesUnlocked": {
      "description": "Boolean list — one entry per Power node in powerNodeOrder. True if that node is unlocked. Must be read together with powerNodesLevel at the same index to determine the tier.",
      "indexing": "node index i → powerNodesUnlocked[i]"
    },
    "powerNodesLevel": {
      "description": "Integer list — parallel to powerNodesUnlocked. Stores the 0-based tier step for each Power node, so the displayed tier is powerNodesLevel[i] + 1 (0 → x1, 1 → x2, 2 → x3).",
      "indexing": "node index i → powerNodesLevel[i]",
      "valueFormat": "integer, 0-based — rendered as 'x' + (powerNodesLevel[i] + 1)"
    }
  },
  "powerNodeValueRules": {
    "description": "How a Power node's stored pair (unlocked, level) becomes the value written to the sheet. Nodes whose name contains 'Unlock' (the 'Tier x2 Unlock' / 'Tier x3 Unlock' nodes) are booleans; every other node is a multiplier string.",
    "unlockNodes": {
      "match": "powerNodeOrder[i] contains the substring 'Unlock'",
      "unlocked": true,
      "locked": false
    },
    "multiplierNodes": {
      "match": "every other node",
      "unlocked": "'x' + (powerNodesLevel[i] + 1)",
      "locked": "'-'"
    }
  },
  "harmonyNodeValueRules": {
    "description": "Every Harmony node is written as a boolean — true when harmonyNodesUnlocked[i] is truthy, false otherwise. Nodes are always emitted, including locked ones."
  },
