{
  "description": "Documents how Ultimate Weapon data is stored in the savedFile format",
  "ultimateWeaponHeaders": {
    "ultimateWeaponUnlocked": "ultimateWeaponUnlocked",
    "ultimateWeaponPlusUnlocked": "ultimateWeaponPlusUnlocked",
    "ultimateWeaponLevel": "ultimateWeaponLevel",
    "ultimateWeaponPlusLevel": "ultimateWeaponPlusLevel"
  },
  "fields": {
    "ultimateWeaponUnlocked": {
      "description": "Boolean list — one entry per weapon in weaponOrder. True if that weapon is unlocked.",
      "indexing": "weapon index i → ultimateWeaponUnlocked[i]"
    },
    "ultimateWeaponPlusUnlocked": {
      "description": "Boolean list — one entry per weapon in weaponOrder. True if the plus upgrade for that weapon is unlocked.",
      "indexing": "weapon index i → ultimateWeaponPlusUnlocked[i]"
    },
    "ultimateWeaponLevel": {
      "description": "Flat integer list — 3 upgrade levels per weapon, packed consecutively. For weapon at index i, its upgrades occupy indices i*3, i*3+1, i*3+2, corresponding to upgrades[0], upgrades[1], upgrades[2] in targetWeapons.",
      "indexing": "weapon index i, upgrade index j (0-2) → ultimateWeaponLevel[i * 3 + j]"
    },
    "ultimateWeaponPlusLevel": {
      "description": "Integer list — one plus upgrade level per weapon in weaponOrder.",
      "indexing": "weapon index i → ultimateWeaponPlusLevel[i]"
    }
  },
  "weaponOrder": {
    "0": "Chain Lightning",
    "1": "Smart Missiles",
    "2": "Death Wave",
    "3": "Chrono Field",
    "4": "Inner Land Mines",
    "5": "Golden Tower",
    "6": "Poison Swamp",
    "7": "Black Hole",
    "8": "Spotlight"
  },
  "weapons": {
