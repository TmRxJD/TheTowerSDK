{
  "description": "Documents how module data is stored in the savedFile format and defines the complete substat effectID encoding",
  "moduleHeaders": {
    "moduleEquipped": "moduleEquipped",
    "inventory": "inventory",
    "assistModuleSlots": "assistModuleSlots"
  },
  "fields": {
    "moduleEquipped": {
      "description": "A single ModuleItem object representing the primary module currently equipped on the tower. Null if no module is equipped.",
      "type": "ModuleItem | null"
    },
    "inventory": {
      "description": "Array of all ModuleItem objects in the player's module inventory (not equipped).",
      "type": "ModuleItem[]",
      "indexing": "inventory[i] → the i-th module in the inventory"
    },
    "assistModuleSlots": {
      "description": "Array of 4 AssistModuleSlot objects (one per module category: Cannon, Armor, Generator, Core). Each slot may hold an equipped assist module.",
      "type": "AssistModuleSlot[]",
      "indexing": "assistModuleSlots[type] where type matches moduleTypeEnum (0=Cannon, 1=Armor, 2=Generator, 3=Core)",
      "note": "The slot's own array position is used as the category — the slot's `type` field is not read. The slot row is always emitted; equippedModule is only read when unlocked is true."
    }
  },
  "valueRules": {
    "description": "How raw save values become the values the app writes. Applies to moduleEquipped, inventory and assistModuleSlots alike unless stated otherwise.",
    "moduleName": "moduleinfoIndex lookup; see unnamedModuleHandling for untracked indices.",
    "rarity": "currentRarity mapped through the currentRarity table, falling back to 'Epic' when the value is outside 1-15.",
    "level": {
      "equipped": "module.level when > 0, otherwise null (written as 'Highest Level').",
      "assist": "equippedModule.level, defaulting to 1 when falsy (written as 'Assist Level')."
    },
    "substats": "Each entry of `effects` resolves to [label, rarity]; unresolvable IDs become [null, null].",
    "inventoryDeduplication": "An inventory module is skipped when a module of the same name and category is already recorded at an equal or higher currentRarity — only the highest-rarity copy of each module survives.",
    "assistSlot": {
      "locked": "assistSlot.unlocked (falsy → false)",
      "rarity": "assistRarities[uniqueEffectEfficiencyLevel] where assistRarities = ['Epic', 'Legendary', 'Mythic', 'Ancestral'], falling back to 'Epic' when out of range",
      "multiplier": "String(mainEffectEfficiencyLevel || 0).padStart(2, '0')",
      "substat": "String(substatEfficiencyLevel || 0).padStart(2, '0')"
    }
  },
  "moduleItemStructure": {
    "description": "Schema for a ModuleItem object as it appears in moduleEquipped, inventory, or assistModuleSlots.equippedModule",
    "_class": "always 'ModuleItem'",
    "guid": "string — UUID uniquely identifying this module instance",
    "infoIndex": "integer — index into the game's internal module type catalog (identifies which module it is by name and category)",
    "level": "integer — current upgrade level of the module",
    "currentRarity": {
      "description": "integer — the module's current rarity/tier level (separate progression from substat rarity enum)",
      "1": "Common",
      "2": "Rare",
      "3": "Rare+",
      "4": "Epic",
      "5": "Epic+",
      "6": "Legendary",
      "7": "Legendary+",
      "8": "Mythic",
      "9": "Mythic+",
      "10": "Ancestral",
      "11": "Ancestral 1*",
      "12": "Ancestral 2*",
      "13": "Ancestral 3*",
      "14": "Ancestral 4*",
      "15": "Ancestral 5*"
  },
    "rerollCounter": "integer — number of times the substat effects have been rerolled",
    "shardsSpent": "integer — cumulative shards spent upgrading this module",
    "coinsSpent": "integer — cumulative coins spent on this module (can exceed 2^32; stored as Int64)",
    "effects": "array of integers — one effectID per substat slot, in slot order (see effectIDSystem). The app iterates this list directly and resolves each entry with lookupEffectID; an entry outside 1-331 yields [null, null] for that slot. NOTE: the scalar values shown under `example` below predate this and do not match how the field is read.",
    "effectLocked": "string — 8-character mask of ✓/✗, one per substat slot (left to right, slot 0 first). ✓ = that slot is locked and will not be rerolled; ✗ = unlocked",
    "isNew": "boolean — true if the module was recently obtained and the 'new' indicator has not been dismissed",
    "favorite": "boolean — true if the module is marked as a favorite"
  },
  "assistModuleSlotStructure": {
    "description": "Schema for an AssistModuleSlot object in assistModuleSlots",
    "_class": "always 'AssistModuleSlot'",
    "type": "integer — module category (0=Cannon, 1=Armor, 2=Generator, 3=Core) — matches moduleTypeEnum",
    "unlocked": "boolean — whether this assist slot has been unlocked",
    "equippedModule": "ModuleItem | null — the assist module currently equipped in this slot",
    "substatEfficiencyLevel": "integer — upgrade level of the substat efficiency bonus for this slot",
    "uniqueEffectEfficiencyLevel": "integer — upgrade level of the unique effect efficiency bonus",
    "mainEffectEfficiencyLevel": "integer — upgrade level of the main effect efficiency bonus"
  },
  "effectIDSystem": {
    "description": "Each substat slot in a module holds an effectID — a flat 1-based sequential integer identifying both the substat type (clusterValue) and its rarity tier. effectIDs are assigned in clusterValue order, rarity order within each cluster.",
    "formula": "effectID = cumulative[clusterValue - 1] + rarityPosition + 1",
    "notes": "rarityPosition is 0-indexed from the lowest available rarity for that substat. cumulative[C] = sum of n(k) for k=1..C. A module only has substats from its own category (Cannon/Armor/Generator/Core).",
    "rarityEnum": {
      "description": "Rarity values used in the substat system (also stored in moduleRarityEnum)",
      "0": "Common",
      "1": "Rare",
      "2": "Epic",
      "3": "Legendary",
      "4": "Mythic",
      "5": "Ancestral"
    },
    "rarityPositionByN": {
      "description": "For a cluster with n available rarities, rarityPosition maps as follows",
      "n=6 (Common+)":    { "Common": 0, "Rare": 1, "Epic": 2, "Legendary": 3, "Mythic": 4, "Ancestral": 5 },
      "n=5 (Rare+)":      { "Rare": 0, "Epic": 1, "Legendary": 2, "Mythic": 3, "Ancestral": 4 },
      "n=4 (Epic+)":      { "Epic": 0, "Legendary": 1, "Mythic": 2, "Ancestral": 3 },
      "n=3 (Legendary+)": { "Legendary": 0, "Mythic": 1, "Ancestral": 2 },
      "n=2 (Mythic+)":    { "Mythic": 0, "Ancestral": 1 },
      "n=1 (Ancestral)":  { "Ancestral": 0 }
    },
    "moduleTypeEnum": {
      "0": "Cannon",
      "1": "Armor",
      "2": "Generator",
      "3": "Core"
    },

