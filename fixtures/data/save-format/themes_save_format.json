{
  "description": "Documents how Themes & Songs data is stored in the savedFile format. Each list is a boolean array indexed by skin/track index; the app maps an index to a name only if that index appears in the corresponding order table below. Indices absent from a table are entries the app does not track (defaults that ship unlocked, or unreleased slots) and are silently ignored.",
  "themesHeaders": {
    "towerSkins": "towerUnlocked",
    "backgroundSkins": "backgroundUnlocked",
    "menuSkins": "menuUnlocked",
    "guardianSkins": "guardianSkinUnlocked",
    "profileBanners": "profileBannerUnlocked",
    "songs": "trackAvailable",
    "relicsUnlocked": "relicsUnlocked"
  },
  "headerNote": "relicsUnlocked belongs to the same themesAndRelicsHeaders group and is parsed by the same function, but its index table lives in relics_save_format.json.",
  "outputGroups": {
    "description": "parseThemesAndRelicsData returns oldThemesNames keyed by these sheet groups, in this order (themesOrder). Only unlocked entries are pushed.",
    "order": [
      "Tower Skin",
      "Background Skin",
      "Milestone Skin",
      "Guardians",
      "Profile Banner",
      "Menu",
      "Songs"
    ]
  },
  "fields": {
    "towerUnlocked": {
      "description": "Boolean list covering both regular tower skins and milestone skins — the two share one array. Each index is checked against towerSkinOrder and milestoneSkinOrder independently: a hit in the first is written to the 'Tower Skin' group, a hit in the second to the 'Milestone Skin' group. The two tables never overlap, and index 0 (the default skin) is in neither.",
      "indexing": "skin index i → towerUnlocked[i]"
    },
    "backgroundUnlocked": {
      "description": "Boolean list — one entry per background. Index 0 is the default background and is not tracked.",
      "indexing": "skin index i → backgroundUnlocked[i]"
    },
    "menuUnlocked": {
      "description": "Boolean list — one entry per menu theme. Index 0 is the default menu and is not tracked.",
      "indexing": "menu index i → menuUnlocked[i]"
    },
    "guardianSkinUnlocked": {
      "description": "Boolean list — one entry per guardian skin. Indices 0 (Orbie) and 3 (Harriot) are starter guardians that ship unlocked and are not tracked.",
      "indexing": "skin index i → guardianSkinUnlocked[i]"
    },
    "profileBannerUnlocked": {
      "description": "Boolean list — one entry per profile banner. Index 0 is the default banner and is not tracked.",
      "indexing": "banner index i → profileBannerUnlocked[i]"
    },
    "trackAvailable": {
      "description": "Boolean list — one entry per song. Indices 0-5 are the base tracks that ship available and are not tracked; only the three unlockable tracks (6-8) are.",
      "indexing": "song index i → trackAvailable[i]"
    }
  },
